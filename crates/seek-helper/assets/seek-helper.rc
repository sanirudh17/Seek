#include <winver.h>
1 ICON "../../app/assets/seek.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Seek contributors\0"
            VALUE "FileDescription", "Seek optional indexing helper\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "Seek Helper\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Seek contributors\0"
            VALUE "OriginalFilename", "seek-helper.exe\0"
            VALUE "ProductName", "Seek\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
